{
  "manifest_version": 3,
  "name": "JARVIS Trading Bot",
  "version": "1.0.0",
  "description": "Bedien en bewaak de JARVIS trading bot die op je eigen pc draait.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8770/*",
    "http://localhost:8770/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JARVIS Trading Bot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
