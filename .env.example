# ============================================================
# Coinbase
# ============================================================
# Never commit real values here. This file documents the variable
# names the bot reads; copy it to .env and fill in real credentials
# locally only.

# COINBASE_API_KEY is het veld "name" uit het JSON-bestand dat Coinbase je
# laat downloaden bij het aanmaken van een CDP API-key.
COINBASE_API_KEY=organizations/<your-org-id>/apiKeys/<your-key-id>

# COINBASE_API_SECRET is het veld "privateKey" uit datzelfde JSON-bestand.
# Coinbase geeft dat in een van twee vormen uit; de bot ondersteunt beide.
#
#   1) ECDSA (P-256) als PEM-blok. Zet het op een regel met literal \n:
#      COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n<key_body>\n-----END EC PRIVATE KEY-----\n
#
#   2) Ed25519 als base64-tekst (geen BEGIN/END-regels). Plak die waarde
#      letterlijk over, zonder aanhalingstekens:
#      COINBASE_API_SECRET=<base64_uit_privateKey>
COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n<your_base64_key_body>\n-----END EC PRIVATE KEY-----\n
COINBASE_API_HOST=api.coinbase.com
COINBASE_TIMEOUT_SECONDS=15


# ============================================================
# Trading
# ============================================================

ALLOWED_TICKERS=BTC-USDC,ETH-USDC,SOL-USDC,XRP-USDC,LINK-USDC,AVAX-USDC,SUI-USDC,ADA-USDC
MAX_NOTIONAL_USD=100.00
MAX_SPREAD_PCT=0.0060


# ============================================================
# Execution
# ============================================================

EXECUTION_MODE=paper
ANALYSIS_TIMEFRAMES=1D,4H,1H,15m
PRIMARY_INTERVAL_HOURS=4
MAX_OPEN_POSITIONS=3
COOLDOWN_MINUTES=240
MAX_DAILY_LOSS_USDC=50.00
DEFAULT_QUOTE_SIZE_USDC=50.00


# ============================================================
# Inventory / residual selling safety
# ============================================================

INVENTORY_SELL_ENABLED=false
INVENTORY_SELL_MODE=bot_only
INVENTORY_MAX_EXTRA_SELL_FRACTION=0.00
INVENTORY_SEVERE_RISK_ONLY=true
INVENTORY_MIN_RESIDUAL_BASE=0
INVENTORY_REDUCE_FRACTION_ON_SEVERE=0.25


# ============================================================
# Candidate selection / gating
# ============================================================

MAX_CANDIDATES_FOR_DEEPSEEK_GATE=10
ENABLE_MARKET_BREADTH_RELAXATION=true
BREADTH_RELAXATION_MIN_TICKERS=3
WATCH_PROMOTION_MEMORY_CYCLES=2


# ============================================================
# Cost-aware expensive judge gate
# ============================================================

ENABLE_EXPENSIVE_JUDGE_GATE=true
JUDGE_MIN_GATE_CONFIDENCE=56
JUDGE_MIN_SYNTH_CONFIDENCE=58
JUDGE_MIN_BULL_SCORE=54
JUDGE_MAX_BEAR_SCORE=70


# ============================================================
# DeepSeek
# ============================================================

ENABLE_DEEPSEEK_PREPROCESS=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# ============================================================
# OpenAI
# ============================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ANALYST_MODEL=gpt-5.4-mini
OPENAI_JUDGE_MODEL=gpt-5.5


# ============================================================
# Anthropic / Claude
#
# Optional fallback provider. Leave ENABLE_ANTHROPIC_FALLBACK=false
# and ANTHROPIC_API_KEY empty if you do not use it.
# ============================================================

ENABLE_ANTHROPIC_FALLBACK=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-6


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# Server 2 replication
# ============================================================

REPLICA_URL=http://your-replica-host:8787
REPLICA_SHARED_HMAC_SECRET=your_shared_hmac_secret_here
REPLICATION_SOURCE_BOT=SERVER1-MASTER
REPLICATION_TIMEOUT_SECONDS=15
REPLICATION_VERIFY_TLS=false

# Judge runner / soft override
JUDGE_SOFT_OVERRIDE_ENABLED=true
JUDGE_SOFT_OVERRIDE_MIN_CONFIDENCE=65
JUDGE_SOFT_OVERRIDE_MIN_ADX=25
JUDGE_SOFT_OVERRIDE_REQUIRE_PROFIT=true
