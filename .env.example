# ==========================================================================
# HERSTEL BIJ STORINGEN  (retry / backoff / cooldown)
# ==========================================================================
# Deze instellingen bepalen hoe JARVIS reageert op een tijdelijke storing:
# een netwerkhapering, een timeout, een rate limit of een provider die even
# uit de lucht is. Ze hebben geen enkele invloed op de handelsstrategie.
#
# Alles hieronder is optioneel. Laat je een regel weg, dan geldt de waarde
# die erachter staat. Alles staat in seconden, behalve waar anders vermeld.

# --- Hoofdlus van de bot ---------------------------------------------------
# Wachttijd na een mislukte handelscyclus. De wachttijd verdubbelt bij elke
# volgende mislukking (30s, 60s, 120s, 240s) en wordt teruggezet zodra een
# cyclus weer normaal doorloopt.
JARVIS_RECOVERY_BASE_DELAY=30
# Bovengrens voor die oplopende wachttijd.
JARVIS_RECOVERY_MAX_DELAY=300
# Na dit aantal mislukkingen op rij volgt een langere afkoelperiode.
JARVIS_RECOVERY_MAX_ATTEMPTS=5
# Lengte van die afkoelperiode.
JARVIS_RECOVERY_COOLDOWN=300

# --- Losse API-aanroepen ---------------------------------------------------
# Aantal pogingen (inclusief de eerste) voor een enkele aanroep naar een API.
JARVIS_RETRY_MAX_ATTEMPTS=3
JARVIS_RETRY_BASE_DELAY=2
JARVIS_RETRY_MAX_DELAY=60
# Spreiding op de wachttijd, tussen 0 en 1. Voorkomt dat alle onderdelen na
# een storing op exact hetzelfde moment terugkomen en de provider overspoelen.
JARVIS_RETRY_JITTER=0.25

# ==========================================================================
# PROCESBEWAKING  (supervisor)
# ==========================================================================
# De bot draait onder een bewaker die hem na een crash opnieuw start.
# Hoe vaak dat maximaal mag, binnen welk tijdvenster.
JARVIS_SUPERVISOR_MAX_RESTARTS=10
JARVIS_SUPERVISOR_WINDOW=3600
# Zo lang draaien telt als "het werkte"; de wachttijd begint dan weer vooraan.
JARVIS_SUPERVISOR_STABLE_SECONDS=300
# Hoe lang de bewaker wacht op een nette afsluiting voordat hij het proces
# alsnog stopt. Ruim genoeg om een lopende handelscyclus af te maken.
JARVIS_SUPERVISOR_STOP_SECONDS=30

# ==========================================================================
# ACHTERGRONDDIENST VOOR DE CHROME-EXTENSIE
# ==========================================================================
# Poort waarop de extensie de bot bedient. Alleen wijzigen als deze poort al
# door een ander programma gebruikt wordt; pas dan ook het adres aan in de
# instellingen van de extensie en in extension/manifest.json.
JARVIS_CONTROL_PORT=8770
# De dienst luistert alleen op je eigen pc. Hier iets anders invullen maakt
# het starten en stoppen van de bot vanaf het netwerk bereikbaar; doe dat
# alleen als je precies weet waarom.
JARVIS_CONTROL_HOST=127.0.0.1

# ==========================================================================
# DASHBOARD
# ==========================================================================
DASHBOARD_PORT=8000
DASHBOARD_HOST=127.0.0.1
