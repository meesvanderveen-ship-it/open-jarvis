# Runtime credentials and local operational state
# Anchored to repo root (leading slash) -- unanchored patterns here
# previously also matched same-named directories nested elsewhere (e.g.
# dashboard/frontend/src/features/{logs,reports} and
# dashboard/frontend/src/components/layout/data), silently keeping those
# entire frontend features out of version control.
.env
.env.*
!.env.example
/state/
/logs/
/reports/
/data/

# Secrets / keys, defense-in-depth beyond the .env rules above
*.pem
*.key
*credentials*
*secret*
*token*

# Local environments, generated bytecode, and test caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Server-local recovery material; source changes are tracked in Git instead.
backups/
backup_*/
*.bak
*.bak.*
*.bak_*

# Agent tooling configuration, not part of the published bot
.codex/
.claude/
.agents/

# Non-source server artefacts and one-off diagnostics
research_data/
*.zip
=*
3:
local
cancel-first
stop
